{
  "exe": "${MAYA_DIR}/build/strata",
  "args": [
    "--glm-pack",
    "${MODEL_DIR}/pack",
    "--max-context",
    "262144",
    "--expert-cache",
    "auto",
    "--prefill",
    "2048",
    "--kv-streaming",
    "on",
    "--expert-profile",
    "${MAYA_DIR}/data/expert-profile-glm.bin"
  ],
  "cwd": "${MAYA_DIR}",
  "tokenizer": "${MODEL_DIR}/pack/tokenizer",
  "model_name": "glm-5.3-flash",
  "gpu": [
    2,
    0,
    1,
    3
  ],
  "sampling": {
    "temperature": 1.0,
    "top_p": 0.95,
    "top_k": 20,
    "min_p": 0.0
  },
  "reasoning_effort": "high",
  "lib_dirs": [
    "${CUDA_ROOT}/lib64",
    "${CUDA_ROOT}/targets/x86_64-linux/lib"
  ],
  "port": 8080,
  "env": {
    "STRATA_GLM_RAM_GB": "48",
    "STRATA_GLM_RAM_RESIDENT": "1"
  },
  "host": "${BIND_HOST}",
  "vision": {
    "exe": "${RUNTIME_DIR}/vision-on-v100.sh",
    "mmproj": "${MODEL_DIR}/vision/mmproj-GLM-5.3-Flash-F16.gguf",
    "model": "${MODEL_DIR}/vision/GLM-5.3-Flash-vocab.gguf",
    "gpu": true,
    "resident": true
  },
  "log": "${RUNTIME_DIR}/maya.log",
  "installer": {
    "models_dir": "${MODEL_DIR}/..",
    "quant": "Maya-M",
    "gguf": null,
    "gguf_dir": null,
    "draft": "mtp",
    "written": "2026-10-16 00:36"
  }
}
