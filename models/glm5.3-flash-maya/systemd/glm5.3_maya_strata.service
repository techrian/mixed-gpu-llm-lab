[Unit]
Description=Project Maya GLM5.3 Maya-M on mixed NVIDIA GPUs
After=network.target
Conflicts=qwen3.8_flash_next_strata.service
Before=qwen3.8_flash_next_strata.service

[Service]
Type=simple
WorkingDirectory=%h/mixed-gpu-llm-lab/models/glm5.3-flash-maya
ExecStart=/usr/bin/python3 %h/mixed-gpu-llm-lab/models/glm5.3-flash-maya/scripts/run.py
MemoryAccounting=yes
MemorySwapMax=0
Restart=on-failure
RestartSec=15
TimeoutStopSec=120

[Install]
WantedBy=default.target
