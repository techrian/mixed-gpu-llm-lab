[Unit]
Description=Strata Qwen3.8 Flash Next on mixed NVIDIA GPUs
After=network.target
Conflicts=glm5.3_maya_strata.service
After=glm5.3_maya_strata.service

[Service]
Type=simple
# Adjust these two paths if this repository is cloned elsewhere.
WorkingDirectory=%h/mixed-gpu-llm-lab/models/qwen3.8-flash-next
ExecStart=/usr/bin/python3 %h/mixed-gpu-llm-lab/models/qwen3.8-flash-next/scripts/run.py
MemoryAccounting=yes
MemorySwapMax=0
Restart=on-failure
RestartSec=15
TimeoutStopSec=120

[Install]
WantedBy=default.target
