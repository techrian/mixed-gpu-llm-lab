[Unit]
Description=Strata Qwen3.8 Flash Next on mixed NVIDIA GPUs
After=network.target

[Service]
Type=simple
# Adjust these two paths if this repository is cloned elsewhere.
WorkingDirectory=%h/strata-qwen38-mixed-gpu-setup
ExecStart=/usr/bin/python3 %h/strata-qwen38-mixed-gpu-setup/scripts/run.py
MemoryAccounting=yes
MemorySwapMax=0
LimitMEMLOCK=infinity
Restart=on-failure
RestartSec=15
TimeoutStopSec=120

[Install]
WantedBy=default.target
